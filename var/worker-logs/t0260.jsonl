atches_neg = host.eval_with_dom(\"document.getElementById('t').matches('a')\", &mut dom);\n        assert_eq!(res_matches_neg, Ok(\"false\".to_string()));\n\n        // closest hit: find ancestor <div> by its class selector\n        let res_closest_hit_class = host.eval_with_dom(\"document.getElementById('t').closest('div.x').id\", &mut dom);\n        assert_eq!(res_closest_hit_class, Ok(\"d1\".to_string()));\n\n        // closest hit: find ancestor <div> by tag selector\n        let res_closest_hit_tag = host.eval_with_dom(\"document.getElementById('t').closest('div').id\", &mut dom);\n        assert_eq!(res_closest_hit_tag, Ok(\"d1\".to_string()));\n\n        // closest self: matches itself\n        let res_closest_self = host.eval_with_dom(\"document.getElementById('t').closest('p').id\", &mut dom);\n        assert_eq!(res_closest_self, Ok(\"t\".to_string()));\n\n        // closest miss: does not exist\n        let res_closest_miss = host.eval_with_dom(\"document.getElementById('t').closest('table') === null\", &mut dom);\n        assert_eq!(res_closest_miss, Ok(\"true\".to_string()));\n    }\n\n    #[test]\n    fn test_eval_with_dom_get_elements_by_tag_name() {"}}
