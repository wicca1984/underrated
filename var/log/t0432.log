{"type":"tool_use","timestamp":"2026-06-12T16:42:15.602Z","tool_name":"replace","tool_id":"replace__7v7ootch","parameters":{"instruction":"Add test_template_children_excluded_from_layout to verify template contents exclusion from layout.","new_string":"        let line_height = 8.0;\n        assert!(y_of_b >= y_of_a + 2.0 * line_height - EPSILON);\n    }\n\n    #[test]\n    fn test_template_children_excluded_from_layout() {\n        // Guard that `<template>` element children (inert DocumentFragment contents) are excluded from the layout tree.\n        use crate::encoding::input_stream::InputStream;\n        use crate::html::parse_document;\n\n        let html = \"<div><template><p>HIDDEN</p></template><span>SHOWN</span></div>\";\n        let input_stream = InputStream::from_utf8(html.as_bytes());\n        let dom = parse_document(input_stream);\n\n        let stylesheet = parse_stylesheet(crate::engine::UA_DEFAULT_CSS);\n        let styles = compute_styles(&dom, &stylesheet);\n        let layout_tree = layout_document(&dom, &styles, 800.0);\n\n        fn has_text(layout_box: &LayoutBox, target: &str) -> bool {\n            if let Some(ref text) = layout_box.text {\n                if text.contains(target) {\n                    return true;\n                }\n            }\n            for child in &layout_box.children {\n                if has_text(child, target) {\n                    return true;\n                }\n            }\n            false\n        }\n\n        fn has_node_with_name(layout_box: &LayoutBox, dom: &Dom, name_to_find: &str) -> bool {\n            if let Some(node_id) = layout_box.node {\n                if let Some(NodeData::Element { name, .. }) = dom.data(node_id) {\n                    if name == name_to_find {\n                        return true;\n                    }\n                }\n            }\n            for child in &layout_box.children {\n                if has_node_with_name(child, dom, name_to_find) {\n                    return true;\n                }\n            }\n            false\n        }\n\n        assert!(has_text(&layout_tree, \"SHOWN\"), \"SHOWN should be present in layout\");\n        assert!(!has_text(&layout_tree, \"HIDDEN\"), \"HIDDEN should NOT be present in layout\");\n\n        assert!(has_node_with_name(&layout_tree, &dom, \"span\"), \"span should be in layout tree\");\n        assert!(!has_node_with_name(&layout_tree, &dom, \"p\"), \"p under template should NOT be in layout tree\");\n    }\n}","allow_multiple":false,"file_path":"src/layout/mod.rs","old_string":"        let line_height = 8.0;\n        assert!(y_of_b >= y_of_a + 2.0 * line_height - EPSILON);\n    }\n}"}}
