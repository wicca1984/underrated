{"type":"tool_use","timestamp":"2026-06-12T13:20:54.010Z","tool_name":"replace","tool_id":"replace__d8xebd59","parameters":{"old_string":"fn is_enabled(dom: &Dom, node: NodeId) -> bool {\n    match dom.data(node) {\n        Some(NodeData::Element { name, attrs }) => {\n            is_form_associated(name)\n                && !attrs\n                    .iter()\n                    .any(|(k, _)| ascii::eq_ignore_ascii_case(k, \"disabled\"))\n        }\n        _ => false,\n    }\n}","instruction":"Add helper functions is_required and is_optional right after is_enabled.","allow_multiple":false,"new_string":"fn is_enabled(dom: &Dom, node: NodeId) -> bool {\n    match dom.data(node) {\n        Some(NodeData::Element { name, attrs }) => {\n            is_form_associated(name)\n                && !attrs\n                    .iter()\n                    .any(|(k, _)| ascii::eq_ignore_ascii_case(k, \"disabled\"))\n        }\n        _ => false,\n    }\n}\n\nfn is_required(dom: &Dom, node: NodeId) -> bool {\n    match dom.data(node) {\n        Some(NodeData::Element { name, attrs }) => {\n            let is_applicable = ascii::eq_ignore_ascii_case(name, \"input\")\n                || ascii::eq_ignore_ascii_case(name, \"select\")\n                || ascii::eq_ignore_ascii_case(name, \"textarea\");\n            is_applicable\n                && attrs\n                    .iter()\n                    .any(|(k, _)| ascii::eq_ignore_ascii_case(k, \"required\"))\n        }\n        _ => false,\n    }\n}\n\nfn is_optional(dom: &Dom, node: NodeId) -> bool {\n    match dom.data(node) {\n        Some(NodeData::Element { name, attrs }) => {\n            let is_applicable = ascii::eq_ignore_ascii_case(name, \"input\")\n                || ascii::eq_ignore_ascii_case(name, \"select\")\n                || ascii::eq_ignore_ascii_case(name, \"textarea\");\n            is_applicable\n                && !attrs\n                    .iter()\n                    .any(|(k, _)| ascii::eq_ignore_ascii_case(k, \"required\"))\n        }\n        _ => false,\n    }\n}","file_path":"/workspaces/wt/t0408/src/selector/matching.rs"}}
