et found = bounding_client_rect(&tree, node2);\n        assert!(found.is_none());\n    }","file_path":"/workspaces/wt/t0384/src/layout/mod.rs","instruction":"Insert bounding_client_rect unit tests after test_find_box_rect","old_string":"        // First match is child 1 (rect 10, 10, 100, 100), not child 3 (rect 200, 200, 150, 150)\n        assert!(approx_eq(rect2.origin.x, 10.0));\n        assert!(approx_eq(rect2.origin.y, 10.0));\n        assert!(approx_eq(rect2.size.width, 100.0));\n        assert!(approx_eq(rect2.size.height, 100.0));\n    }","allow_multiple":false}}
