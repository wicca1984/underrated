{"type":"tool_use","timestamp":"2026-06-12T19:02:24.741Z","tool_name":"replace","tool_id":"replace__oamadcof","parameters":{"old_string":"pub(crate) fn is_border_collapse(style: &CategorizedComputedStyle) -> bool {\n    match style.get(\"border-collapse\") {\n        Some(CssValue::Keyword(kw)) => kw == \"collapse\",\n        _ => false,\n    }\n}\n\nfn get_border_spacing(style: &CategorizedComputedStyle) -> (f32, f32) {\n    match style.get(\"border-spacing\") {\n        Some(CssValue::Length(v, _)) => (*v, *v),\n        Some(CssValue::Multiple(values)) if values.len() >= 2 => {\n            let h = match &values[0] {\n                CssValue::Length(v, _) => *v,\n                _ => 0.0,\n            };\n            let v = match &values[1] {\n                CssValue::Length(v, _) => *v,\n                _ => 0.0,\n            };\n            (h, v)\n        }\n        _ => (0.0, 0.0),\n    }\n}","new_string":"pub(crate) fn is_border_collapse(style: &CategorizedComputedStyle) -> bool {\n    style.inherited_table.border_collapse == \"collapse\"\n}\n\nfn get_border_spacing(style: &CategorizedComputedStyle) -> (f32, f32) {\n    let bs = style.inherited_table.border_spacing as f32;\n    (bs, bs)\n}","instruction":"Simplify is_border_collapse and get_border_spacing helper functions.","file_path":"src/layout/table.rs","allow_multiple":false}}
