{
  "name": "toy-browser",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",

  "features": {
    // node is required because the claude-code feature is installed via npm
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },

  // joining llm-net lets us reach the llama-server container by DNS name
  "runArgs": ["--network=llm-net"],

  // OpenAI-compatible endpoint that in-container CLIs (Claude Code, etc.) reference
  "containerEnv": {
    "OPENAI_BASE_URL": "http://llama-server:8080/v1",
    "OPENAI_API_KEY": "not-used",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    // cargo home is /usr/local/cargo in the base image; set explicitly since the registry is offloaded to a named volume
    "CARGO_HOME": "/usr/local/cargo"
  },

  // Auth isolation policy (following _template-python, zenn.dev/y_dkama/articles/windows-zed-devcontainers):
  //  - gh is isolated **per project** (PAT scope = repo isolation matters)
  //  - claude is **shared across all projects** (one claude /login anywhere authenticates every container)
  //  - gemini is also **shared across all projects** (driven via ACP from the Zed Agent Panel; same policy as claude)
  //  - cargo-registry is **shared across all projects** (avoids duplicate crate downloads; the Rust analog of uv-cache)
  "mounts": [
    "source=${localWorkspaceFolderBasename}-gh-config,target=/home/vscode/.config/gh,type=volume",
    "source=shared-claude-config,target=/home/vscode/.claude,type=volume",
    "source=shared-gemini-config,target=/home/vscode/.gemini,type=volume",
    "source=cargo-registry,target=/usr/local/cargo/registry,type=volume"
  ],

  "postCreateCommand": "bash .devcontainer/setup.sh"
}
